{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/bank-logo.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/sitemap\\.xml",
      "dest": "/sitemap.xml",
      "headers": { "Content-Type": "application/xml; charset=utf-8" }
    },
    {
      "src": "/robots\\.txt",
      "dest": "/robots.txt",
      "headers": { "Content-Type": "text/plain; charset=utf-8" }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    },
    {
      "src": "/api/bank-logo\\.php",
      "dest": "/api/bank-logo.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
